  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hoznas/binop-interpriter/issues"
  },
  "homepage": "https://github.com/hoznas/binop-interpriter#readme",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  ,
    "esbuild": "^0.18.0"
  }
}
